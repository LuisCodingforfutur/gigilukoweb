{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://apps.apple.com/de/app/gigiluko/id6764666289",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://apps.apple.com/de/app/gigiluko/id6764666289",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
