{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://apps.apple.com/de/app/gigiluko/id6764666289",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://apps.apple.com/de/app/gigiluko/id6764666289",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/event/:id",
      "destination": "/api/share?type=event&id=:id"
    },
    {
      "source": "/venue/:id",
      "destination": "/api/share?type=venue&id=:id"
    },
    {
      "source": "/post/:id",
      "destination": "/api/share?type=post&id=:id"
    },
    {
      "source": "/performer/:id",
      "destination": "/api/share?type=performer&id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
